def version(pomPath)
{
    def matcher = readFile("${pomPath}") =~ /(?s)\s*<parent>.*<version>(.*)<\/version>.*<\/parent>\s*/
    matcher ? matcher[0][1] : null
    return matcher[0][1]
}


