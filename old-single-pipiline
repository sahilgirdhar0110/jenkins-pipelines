def tokenRefresh()
{
	
	sh 'rm  ~/.dockercfg || true'
    sh 'rm ~/.docker/config.json || true'
	sh 'eval $(aws ecr get-login --no-include-email --region eu-west-1)'
}

def cloneBuildCore(){
    git branch: "${CORE_BRANCH_NAME}",
    url: 'ssh://git-codecommit.eu-west-1.amazonaws.com/v1/repos/oaknorth-core'
    sh 'mvn -f pom.xml clean install -DskipTests -Dmaven.wagon.http.ssl.insecure=true -Dmaven.wagon.http.ssl.allowall=true -Dmaven.wagon.http.ssl.ignore.validity.dates=true -Dmaven.wagon.http.ssl.ignore.validity.dates=true'
}

def buildPushDockerImage(ecr_repo_name,docker_file_path,service_pom_file_path,registry_name)
{
	
	notification_service_version = version(service_pom_file_path)
	tokenRefresh()
	docker.withRegistry("https://${registry_name}" )
	{
		docker.build(ecr_repo_name +":${notification_service_version}","-f ${docker_file_path} .").push("$notification_service_version")
	}
}

def triggerDeployOnLocal(deploy_job_name,service_pom_file_path)
{
	
	stage ("Triggering ${deploy_job_name} Job on ${params.DEPLOY_ENV}")
	{
		notification_service_version = version("${service_pom_file_path}")
		build job: "${deploy_job_name}",
			parameters: [
                                string(name: "notification_service_version", value: "${notification_service_version}")
                        ]
	}
}



def triggerDeployOnRemote(deploy_job_name,jenkin_server_url,jenkin_server_user_token,jenkin_server_user,service_pom_file_path)
{
	
	stage ("Triggering ${deploy_job_name} Job on ${params.DEPLOY_ENV}")
	{
		notification_service_version = version("${service_pom_file_path}")

		def handle = triggerRemoteJob job: "${jenkin_server_url}/job/${deploy_job_name}", parameters: "notification_service_version=${notification_service_version}",auth: TokenAuth(apiToken: "${jenkin_server_user_token}", userName: "${jenkin_server_user}")

	}
}

def triggerDeployOnPreLive(deploy_job_name,jenkin_server_url,jenkin_server_user_token,jenkin_server_user,service_pom_file_path)
{
	
	stage ("Triggering ${deploy_job_name} Job on ${params.DEPLOY_ENV}")
	{
		notification_service_version = version("${service_pom_file_path}")

		def handle = triggerRemoteJob job: "${jenkin_server_url}/job/${deploy_job_name}", parameters: "notification_service_version=${notification_service_version}",blockBuildUntilComplete: false,auth: TokenAuth(apiToken: "${jenkin_server_user_token}", userName: "${jenkin_server_user}")

	}
}

